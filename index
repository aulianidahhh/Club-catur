<style>
  :root { --ebony:#24211D; --ivory:#F1E8D4; --felt:#3F5E4B; --brass:#B5893A; --brick:#A4483A; --slate:#4B6A88; --line:#D7DBD2; }
  html, body { background:#E8EBE4; }
  body { font-family:'Public Sans', system-ui, sans-serif; color:var(--ebony); -webkit-font-smoothing:antialiased; }
  .checker { background: repeating-conic-gradient(var(--ivory) 0 25%, var(--felt) 0 50%) 0 0 / 14px 14px; }
  .checker-dark { background: repeating-conic-gradient(#3a352f 0 25%, #2b2722 0 50%) 0 0 / 22px 22px; }
  .card { background:#fff; border:1px solid var(--line); border-radius:14px; }
  .btn { display:inline-flex; align-items:center; justify-content:center; gap:.4rem; padding:.6rem 1rem; border-radius:10px; font-weight:600; font-size:.9rem; transition:background .15s, color .15s, border-color .15s; }
  .btn-primary { background:var(--ebony); color:var(--ivory); }
  .btn-primary:hover { background:#3a352f; }
  .btn-ghost { background:#fff; border:1px solid var(--line); color:var(--ebony); }
  .btn-ghost:hover { background:#F3F4EF; }
  .btn-danger { background:#fff; border:1px solid #E5C9C3; color:var(--brick); }
  .btn-danger:hover { background:#FBF1EF; }
  .field { width:100%; border:1px solid var(--line); border-radius:10px; padding:.6rem .75rem; background:#fff; font-size:.95rem; }
  .field:focus { outline:2px solid var(--brass); outline-offset:1px; border-color:transparent; }
  :focus-visible { outline:2px solid var(--brass); outline-offset:2px; }
  .nav-btn { display:flex; align-items:center; gap:.75rem; width:100%; padding:.7rem .9rem; border-radius:10px; color:#CFC6B4; font-weight:500; position:relative; }
  .nav-btn:hover { background:rgba(241,232,212,.06); color:#fff; }
  .nav-btn.active { background:rgba(241,232,212,.1); color:#fff; }
  .nav-btn.active::before { content:''; position:absolute; left:-.75rem; top:.55rem; bottom:.55rem; width:3px; border-radius:3px; background:var(--brass); }
  .nav-btn .glyph { font-size:1.35rem; line-height:1; width:1.5rem; text-align:center; }
  .mnav-btn { flex:1; display:flex; flex-direction:column; align-items:center; gap:2px; padding:.5rem 0 .45rem; font-size:.7rem; color:#A79F90; }
  .mnav-btn .glyph { font-size:1.35rem; line-height:1.1; }
  .mnav-btn.active { color:#fff; }
  .mnav-btn.active .glyph { color:var(--brass); }
  .st { min-width:2.5rem; padding:.45rem .55rem; border-radius:8px; border:1px solid var(--line); font-weight:600; font-size:.8rem; color:#6b6f66; background:#fff; transition:background .12s, color .12s; }
  .st:hover { background:#F3F4EF; }
  .st.on.H { background:var(--felt); border-color:var(--felt); color:#fff; }
  .st.on.I { background:var(--slate); border-color:var(--slate); color:#fff; }
  .st.on.S { background:var(--brass); border-color:var(--brass); color:#fff; }
  .st.on.A { background:var(--brick); border-color:var(--brick); color:#fff; }
  .chip { display:inline-flex; align-items:center; gap:.35rem; font-size:.78rem; padding:.2rem .55rem; border-radius:999px; background:#F1F2EE; color:#4d5049; }
  .dot { width:.55rem; height:.55rem; border-radius:999px; display:inline-block; }
  .pc { width:.7rem; height:.7rem; border-radius:3px; display:inline-block; flex:none; border:1px solid #9a9488; }
  .pc.w { background:#fff; } .pc.b { background:var(--ebony); border-color:var(--ebony); }
  .score { font-family:'Young Serif', Georgia, serif; font-size:.95rem; padding:.15rem .5rem; border-radius:6px; background:#F1F2EE; white-space:nowrap; }
  .res-btn { border:1.5px solid var(--line); border-radius:12px; padding:.75rem .5rem; background:#fff; text-align:center; transition:border-color .12s, background .12s; }
  .res-btn:hover { background:#F7F7F3; }
  .res-btn.on { border-color:var(--ebony); background:var(--ebony); color:var(--ivory); }
  .seg { display:inline-flex; background:#DDE1D8; border-radius:10px; padding:3px; gap:2px; }
  .seg button { padding:.45rem .85rem; border-radius:8px; font-size:.85rem; font-weight:600; color:#585c54; }
  .seg button.on { background:#fff; color:var(--ebony); box-shadow:0 1px 2px rgba(36,33,29,.12); }
  table.tbl { width:100%; border-collapse:collapse; font-size:.9rem; }
  table.tbl th { text-align:left; font-weight:600; font-size:.78rem; color:#6b6f66; padding:.6rem .75rem; border-bottom:1px solid var(--line); white-space:nowrap; }
  table.tbl td { padding:.7rem .75rem; border-bottom:1px solid #ECEEE8; white-space:nowrap; }
  table.tbl tr:last-child td { border-bottom:none; }
  table.tbl tbody tr.clickable:hover { background:#F7F8F4; cursor:pointer; }
  .num { text-align:right; font-variant-numeric:tabular-nums; }
  .bar { height:6px; background:#ECEEE8; border-radius:99px; overflow:hidden; }
  .bar > span { display:block; height:100%; border-radius:99px; }
  #toast { transition:opacity .2s, transform .2s; }
  .modal-back { background:rgba(36,33,29,.55); }
  .podium-step { border-radius:12px 12px 0 0; }
  @keyframes rise { from { transform:translateY(12px); opacity:0 } to { transform:none; opacity:1 } }
  .rise { animation:rise .45s ease-out both; }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition:none !important; animation:none !important; } }
  [data-sync][data-state="error"] { color:#E8A196; cursor:pointer; text-decoration:underline; }
  .safe-bottom { padding-bottom: env(safe-area-inset-bottom, 0px); }
</style>
