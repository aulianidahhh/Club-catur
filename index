    <div class="flex">
      <button class="mnav-btn" data-action="nav" data-view="dashboard"><span class="glyph">♔</span>Beranda</button>
      <button class="mnav-btn" data-action="nav" data-view="siswa"><span class="glyph">♙</span>Absensi</button>
      <button class="mnav-btn" data-action="nav" data-view="match"><span class="glyph">♘</span>Pertandingan</button>
      <button class="mnav-btn" data-action="nav" data-view="rank"><span class="glyph">♕</span>Peringkat</button>
    </div>
  </nav>
</div>

<!-- Modal -->
<div id="modal" class="fixed inset-0 z-50 hidden">
  <div class="modal-back absolute inset-0" data-action="closeModal"></div>
  <div class="relative h-full flex items-end sm:items-center justify-center p-0 sm:p-6 pointer-events-none">
    <div id="modalBody" class="pointer-events-auto bg-white w-full sm:max-w-lg rounded-t-2xl sm:rounded-2xl max-h-[88vh] overflow-y-auto shadow-2xl"></div>
  </div>
</div>

